WORKER_BASE_URL=https://worker.example.invalid
EDGE_HOSTNAME=worker.example.invalid
OPTIMIZER_TOKEN=replace-with-a-random-token-at-least-24-characters
DATA_DIR=/data

# Safety default: measurement only. Enable only after the manual handoff drill.
PUBLISH_ENABLED=false

# Optional overrides. Leave CF_IPV4_CIDRS unset to use the built-in Cloudflare IPv4 list.
# CF_IPV4_CIDRS=104.16.0.0/13,172.64.0.0/13
SEED_ADDRESSES=
PROBE_TIMEOUT_MS=5000
API_TIMEOUT_MS=8000
CONCURRENCY=12
FAST_CANDIDATE_COUNT=64
FULL_CANDIDATE_COUNT=192
